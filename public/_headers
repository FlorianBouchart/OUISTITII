# Politique de cache — lue par Cloudflare, qui impose sinon la sienne.
#
# Sans cela, un téléphone ayant déjà ouvert l'application garderait la page du
# premier jour et ne verrait jamais les corrections.

/*.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# Le reste porte un numéro de version dans son adresse : un fichier modifié
# change d'adresse, on peut donc le garder longtemps.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable
