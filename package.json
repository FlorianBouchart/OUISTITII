{
  "name": "ouistitii-par-tf",
  "version": "1.0.0",
  "private": true,
  "description": "OUISTITII par T&F — l'application photo et vidéo du mariage de Thomy & Florian",
  "type": "module",
  "scripts": {
    "db:create": "./node_modules/.bin/wrangler d1 create ouistitii",
    "db:dump": "node -e \"const fs=require('fs');import('./worker/schema.js').then(m=>{fs.writeFileSync('schema.sql',m.SCHEMA.map(s=>s+';').join('\\n\\n')+'\\n');console.log('schema.sql régénéré')})\"",
    "db:migrate": "./node_modules/.bin/wrangler d1 execute ouistitii --local --file=schema.sql",
    "db:migrate:remote": "./node_modules/.bin/wrangler d1 execute ouistitii --remote --file=schema.sql",
    "deploy": "./node_modules/.bin/wrangler deploy",
    "dev": "./node_modules/.bin/wrangler dev --port 5185 --r2 MEDIA",
    "google:token": "node scripts/google-token.mjs",
    "login": "./node_modules/.bin/wrangler login",
    "logout": "./node_modules/.bin/wrangler logout",
    "secret:admin": "./node_modules/.bin/wrangler secret put ADMIN_PASSWORD",
    "secret:g-id": "./node_modules/.bin/wrangler secret put GOOGLE_CLIENT_ID",
    "secret:g-key": "./node_modules/.bin/wrangler secret put GOOGLE_CLIENT_SECRET",
    "secret:g-token": "./node_modules/.bin/wrangler secret put GOOGLE_REFRESH_TOKEN",
    "secret:token": "./node_modules/.bin/wrangler secret put TOKEN_SECRET",
    "secrets:list": "./node_modules/.bin/wrangler secret list",
    "setup": "node scripts/setup.mjs",
    "tail": "./node_modules/.bin/wrangler tail",
    "verify": "node scripts/verify-signature.mjs",
    "verify:api": "python3 scripts/verify-chain.py",
    "whoami": "./node_modules/.bin/wrangler whoami"
  },
  "devDependencies": {
    "wrangler": "^4.130.0"
  }
}
